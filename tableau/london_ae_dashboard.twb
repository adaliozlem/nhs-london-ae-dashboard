    <worksheet name='Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>London A&amp;E: patients seen within 4 hours vs standard and interim target</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ae_clean' name='federated.12nij3k0agyvd710s02y50ign20e' />
          </datasources>
          <datasource-dependencies datasource='federated.12nij3k0agyvd710s02y50ign20e'>
            <column caption='4-hour performance' datatype='real' default-format='p0.0%' name='[Calculation_0139563452792832]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([total_attendances]) - SUM([total_over_4h])) / SUM([total_attendances])' />
            </column>
            <column caption='Interim target' datatype='real' default-format='p0.0%' name='[Calculation_0139563463725058]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF MIN([month]) &lt; #2026-04-01# THEN 0.78 ELSE 0.82 END' />
            </column>
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[region]' derivation='None' name='[none:region:nk]' pivot='key' type='nominal' />
            <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
