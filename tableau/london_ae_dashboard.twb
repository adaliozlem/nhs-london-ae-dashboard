            <column caption='Total Attendances' datatype='integer' name='[total_attendances]' role='measure' type='quantitative' />
            <column caption='Total Over 4H' datatype='integer' name='[total_over_4h]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0139563452792832]' derivation='User' name='[usr:Calculation_0139563452792832:qk]' pivot='key' type='quantitative' />
